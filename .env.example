# ClinicFlow AI — Production Environment Configuration
# Copy to .env for local development or configure in Hostinger Web App Environment Variables.
# NEVER commit real secrets or service account keys to Git.

# Server port & runtime mode (Hostinger injects PORT and NODE_ENV=production automatically)
PORT="3000"
NODE_ENV="production"

# Public origin URL of the deployed application (e.g. https://clinicflow.yourdomain.com)
APP_URL="MY_APP_URL"

# Server-side Gemini API Key (NEVER expose in VITE_* variables or frontend bundles)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Comma-separated verified administrator email allowlist
ADMIN_EMAILS="eng4elec.eg@gmail.com"

# Safe fictional graduation demonstration mode ("true" or "false")
DEMO_MODE_ENABLED="true"

# Cloud Firestore & Firebase Admin SDK (Production Persistence)
FIREBASE_PROJECT_ID="gen-lang-client-0940591084"
FIREBASE_DATABASE_ID="ai-studio-0b348bbf-809d-46d6-baa6-21483d092996"
FIREBASE_API_KEY=""

# Provide EITHER FIREBASE_SERVICE_ACCOUNT_JSON (raw JSON or base64-encoded JSON)
# OR FIREBASE_CLIENT_EMAIL + FIREBASE_PRIVATE_KEY
FIREBASE_SERVICE_ACCOUNT_JSON=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""

# Set to "true" to fail startup if Firestore Admin credentials are missing
REQUIRE_FIRESTORE="false"
